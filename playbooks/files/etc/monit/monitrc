set daemon 120
set log /var/log/monit.log
# Ubuntu's monit.service runs with ProtectHome=yes: monit can't write its default id/state files in /root
set idfile /var/lib/monit/id
set statefile /var/lib/monit/state

set mailserver localhost
set mail-format {
  # a sender in the main domain: DKIM-signed and covered by SPF, so the forwarded alerts aren't rejected
  from: monit@{{ main_domain }}
  subject: $SERVICE $EVENT at $DATE
  message: Monit $ACTION $SERVICE at $DATE on $HOST: $DESCRIPTION.
}

set alert root@localhost

# the service checks (conf.d/*, deployed by playbooks/tasks/13-monitoring.yml)
include /etc/monit/conf.d/*

set httpd port 2812 and
    use address localhost
    allow localhost
    allow admin:monit

check system {{ ansible_hostname }}
    if loadavg (1min) per core > 2 for 5 cycles then alert
    if loadavg (5min) per core > 1 for 10 cycles then alert
    if cpu usage > 95% for 10 cycles then alert
    if memory usage > 85% for 3 cycles then alert
    if swap usage > 25% then alert
