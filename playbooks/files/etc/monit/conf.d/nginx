check process nginx with pidfile /run/nginx.pid
  start program = "/usr/bin/systemctl start nginx"
  stop program = "/usr/bin/systemctl stop nginx"
  # alert at once, restart only when nginx keeps failing: out of memory, a slow nginx failed one test, the stop hung
  # for 90 s and every site stayed down 2 more minutes until monit's next cycle started it (freeflarum, 12 Nov 2026)
  if failed host 127.0.0.1 port 80 protocol http then alert
  if failed host 127.0.0.1 port 80 protocol http for 3 cycles then restart
  if 5 restarts within 5 cycles then timeout
  if cpu > 60% for 5 cycles then alert
