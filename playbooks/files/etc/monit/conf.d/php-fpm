check process php-fpm with pidfile /run/php/php{{ php_version }}-fpm.pid
  start program = "/usr/bin/systemctl start php{{ php_version }}-fpm"
  stop program = "/usr/bin/systemctl stop php{{ php_version }}-fpm"
  if failed unixsocket /run/php/php{{ php_version }}-fpm.sock then restart
  if 5 restarts within 5 cycles then timeout
  if cpu > 60% for 2 cycles then alert
  if totalmem > 500.0 MB for 5 cycles then restart