check process mariadb with pidfile /run/mysqld/mysqld.pid
  start program = "/usr/bin/systemctl start mariadb" with timeout 300 seconds
  stop program = "/usr/bin/systemctl stop mariadb" with timeout 300 seconds
  # a restart makes every site fail for ~1 minute: only when MariaDB really stopped answering
  if failed host 127.0.0.1 port 3306 protocol mysql for 3 cycles then restart
  if 5 restarts within 5 cycles then timeout
  if cpu > 90% for 10 cycles then alert
  if totalmem > 60% for 5 cycles then alert
