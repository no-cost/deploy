smtpd_banner = $myhostname ESMTP
biff = no

append_dot_mydomain = no
readme_directory = no
compatibility_level = 3.6

myhostname = {{ postfix.host }}
mydestinations = $mydomain, $myhostname, localhost, localhost.localdomain
mynetworks = 127.0.0.0/8 [::ffff:127.0.0.0]/104 [::1]/128
myorigin = localhost
mydomain = {{ main_domain }}

smtpd_relay_restrictions = permit_mynetworks defer_unauth_destination
smtpd_recipient_restrictions =
    permit_mynetworks,
    reject_unauth_destination,
    check_policy_service unix:postgrey/postgrey.sock
smtpd_sender_restrictions =
    check_sender_access hash:/etc/postfix/sender_access,
    permit

inet_interfaces = all
inet_protocols = ipv4

mailbox_size_limit = 0
recipient_delimiter = +

smtpd_tls_cert_file=/etc/ssl/cloudflare/{{ postfix.host }}.pem
smtpd_tls_key_file=/etc/ssl/cloudflare/{{ postfix.host }}.key
smtpd_tls_security_level=may
smtp_tls_CApath=/etc/ssl/certs
smtp_tls_security_level=may
smtp_tls_session_cache_database = btree:${data_directory}/smtp_scache

virtual_alias_domains = $mydomain
virtual_alias_maps = hash:/etc/postfix/virtual
sender_canonical_maps = pcre:/etc/postfix/sender_canonical
sender_canonical_classes = envelope_sender, header_sender

# DKIM
milter_default_action = accept
milter_protocol = 6

smtpd_milters = unix:opendkim/opendkim.sock, unix:opendmarc/opendmarc.sock
non_smtpd_milters = $smtpd_milters
