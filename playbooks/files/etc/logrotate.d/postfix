# mail.log is rotated by rsyslog's own logrotate config: listing it twice makes logrotate skip that whole file
/var/log/mail.err /var/log/mail.warn {
    daily
    missingok
    rotate 14
    compress
    delaycompress
    notifempty
    create 0640 syslog adm
    sharedscripts
    postrotate
        /usr/lib/rsyslog/rsyslog-rotate
    endscript
}
