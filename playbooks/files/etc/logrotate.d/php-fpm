/var/log/php/*.log {
    daily
    missingok
    rotate 14
    compress
    delaycompress
    notifempty
    create 0640 www-data www-data
    postrotate
        # USR1 reopens the log files; a reload restarts every pool (~1 min with thousands of them)
        [ ! -f /run/php/php-fpm.pid ] || kill -USR1 "$(cat /run/php/php-fpm.pid)"
    endscript
}
