/var/log/mysql/*.log {
    daily
    missingok
    rotate 14
    compress
    delaycompress
    notifempty
    create 0640 mysql mysql
    sharedscripts
    postrotate
        # MariaDB 11+ has no mysqladmin and root authenticates over the unix socket (no /root/.my.cnf)
        [ ! -x /usr/bin/mariadb-admin ] || /usr/bin/mariadb-admin --local flush-error-log flush-engine-log flush-general-log flush-slow-log
    endscript
}
