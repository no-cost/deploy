{{ paths.tenants.root }}/*/logs/*.log {
    daily
    missingok
    rotate 90
    compress
    delaycompress
    notifempty
    create 0640 www-data adm
    sharedscripts
    postrotate
        # nginx.org's package has no init script for `invoke-rc.d nginx rotate`: USR1 reopens the logs
        [ ! -f /run/nginx.pid ] || kill -USR1 "$(cat /run/nginx.pid)"
    endscript
}
